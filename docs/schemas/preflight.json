{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/preflight.json",
  "title": "platecli preflight result envelope",
  "type": "object",
  "required": [
    "status",
    "command",
    "checks"
  ],
  "properties": {
    "status": {
      "type": "string"
    },
    "command": {
      "const": "preflight",
      "type": "string"
    },
    "checks": {
      "items": {
        "properties": {
          "status": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "status",
          "name",
          "message"
        ],
        "type": "object",
        "additionalProperties": true
      },
      "type": "array"
    }
  },
  "additionalProperties": true
}

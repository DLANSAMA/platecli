{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/stop.json",
  "title": "platecli stop success or confirmation envelope",
  "type": "object",
  "required": [
    "status",
    "command",
    "stopped"
  ],
  "properties": {
    "status": {
      "enum": [
        "stopped",
        "confirmation_required"
      ],
      "type": "string"
    },
    "command": {
      "const": "stop",
      "type": "string"
    },
    "stopped": {
      "type": "boolean"
    },
    "next_command": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "additionalProperties": true
}

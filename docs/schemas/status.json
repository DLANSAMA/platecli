{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/status.json",
  "title": "platecli status success envelope",
  "type": "object",
  "description": "JSON output of `plate status --json`. Guaranteed printer fields live under `printer` (never flattened onto the envelope). Firmware extras stay on `printer` as additional properties. `ams` is the normalised tray view for --ams-mapping.",
  "required": [
    "status",
    "command",
    "printer"
  ],
  "properties": {
    "status": {
      "const": "ok",
      "type": "string"
    },
    "command": {
      "const": "status",
      "type": "string"
    },
    "printer": {
      "properties": {
        "gcode_state": {
          "type": "string"
        },
        "mc_percent": {
          "type": "number"
        },
        "bed_temper": {
          "type": "number"
        },
        "bed_target_temper": {
          "type": "number"
        },
        "nozzle_temper": {
          "type": "number"
        },
        "nozzle_target_temper": {
          "type": "number"
        },
        "cooling_fan_speed": {
          "type": "number"
        },
        "wifi_signal": {
          "type": "string"
        },
        "sw_ver": {
          "type": "string"
        },
        "hw_ver": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "gcode_state",
        "mc_percent",
        "bed_temper",
        "nozzle_temper"
      ],
      "additionalProperties": true,
      "description": "Complete printer state. Merged from the MQTT report topic and guaranteed to be a full snapshot, never a partial delta; the command fails with exit code 6 rather than emitting an incomplete object. Extra firmware keys stay here, not on the envelope."
    },
    "ams": {
      "properties": {
        "active_tray": {
          "type": "integer"
        },
        "units": {
          "items": {
            "properties": {
              "id": {
                "type": "integer"
              },
              "humidity": {
                "type": "integer"
              },
              "temp": {
                "type": "number"
              },
              "trays": {
                "items": {
                  "properties": {
                    "slot": {
                      "type": "integer"
                    },
                    "type": {
                      "type": "string"
                    },
                    "color": {
                      "type": "string"
                    },
                    "remain": {
                      "type": "integer"
                    },
                    "empty": {
                      "type": "boolean"
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "type": "object",
                  "required": [],
                  "additionalProperties": true
                },
                "type": "array"
              }
            },
            "type": "object",
            "required": [],
            "additionalProperties": true
          },
          "type": "array"
        },
        "external_tray": {
          "properties": {
            "slot": {
              "type": "integer"
            },
            "type": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "remain": {
              "type": "integer"
            },
            "empty": {
              "type": "boolean"
            },
            "active": {
              "type": "boolean"
            }
          },
          "type": [
            "object",
            "null"
          ],
          "required": [],
          "additionalProperties": true
        }
      },
      "type": [
        "object",
        "null"
      ],
      "required": [],
      "additionalProperties": true,
      "description": "Normalised AMS trays and external spool for --ams-mapping; null when the printer has no AMS."
    }
  },
  "additionalProperties": true
}

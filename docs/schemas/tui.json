{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/tui.json",
  "title": "platecli tui error envelope (interactive command; --json always errors)",
  "type": "object",
  "required": [
    "status",
    "command",
    "exit_code",
    "error",
    "failed_step"
  ],
  "properties": {
    "status": {
      "const": "error",
      "type": "string"
    },
    "command": {
      "const": "tui",
      "type": "string"
    },
    "exit_code": {
      "const": 5,
      "type": "integer"
    },
    "error": {
      "minLength": 1,
      "type": "string"
    },
    "failed_step": {
      "const": "parse",
      "type": "string"
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/doctor.json",
  "title": "platecli doctor result envelope",
  "type": "object",
  "required": [
    "status",
    "command"
  ],
  "properties": {
    "status": {
      "type": "string"
    },
    "command": {
      "const": "doctor",
      "type": "string"
    },
    "checks": {
      "items": {},
      "type": "array"
    },
    "certificate_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "printer_reachable": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/status_event.json",
  "title": "platecli status --monitor NDJSON event",
  "type": "object",
  "required": [
    "event",
    "command",
    "gcode_state",
    "mc_percent"
  ],
  "properties": {
    "event": {
      "enum": [
        "update",
        "terminal"
      ],
      "type": "string"
    },
    "command": {
      "const": "status",
      "type": "string"
    },
    "gcode_state": {
      "type": "string"
    },
    "mc_percent": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}

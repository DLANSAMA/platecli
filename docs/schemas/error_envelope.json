{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/error_envelope.json",
  "title": "platecli JSON error envelope",
  "type": "object",
  "required": [
    "status",
    "command",
    "exit_code",
    "error"
  ],
  "properties": {
    "status": {
      "const": "error",
      "type": "string"
    },
    "command": {
      "minLength": 1,
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "error": {
      "type": "string"
    },
    "failed_step": {
      "type": "string"
    },
    "printer_error_code": {
      "type": "integer"
    },
    "printer_error_code_hex": {
      "type": "string"
    },
    "next_command": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "detail": {
      "additionalProperties": true,
      "type": "object"
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/download.json",
  "title": "platecli download success envelope",
  "type": "object",
  "required": [
    "status",
    "command",
    "source",
    "download_url",
    "path",
    "filename",
    "bytes"
  ],
  "properties": {
    "status": {
      "const": "downloaded",
      "type": "string"
    },
    "command": {
      "const": "download",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "normalized_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "download_url": {
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "filename": {
      "minLength": 1,
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "archive_entry": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

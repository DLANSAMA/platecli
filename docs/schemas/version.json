{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/version.json",
  "title": "platecli --version envelope",
  "type": "object",
  "required": [
    "status",
    "command",
    "version"
  ],
  "properties": {
    "status": {
      "const": "ok",
      "type": "string"
    },
    "command": {
      "const": "version",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false
}

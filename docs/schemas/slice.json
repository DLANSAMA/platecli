{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platecli.local/schemas/slice.json",
  "title": "platecli slice success envelope",
  "type": "object",
  "required": [
    "status",
    "command",
    "file",
    "path",
    "filename",
    "bytes",
    "step_converted"
  ],
  "properties": {
    "status": {
      "const": "sliced",
      "type": "string"
    },
    "command": {
      "const": "slice",
      "type": "string"
    },
    "file": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "filename": {
      "minLength": 1,
      "type": "string"
    },
    "bytes": {
      "type": "integer"
    },
    "step_converted": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}

.env
.env.*
config.json

# Runtime artifacts written by the CLI
temp_leaked_study/
# OrcaSlicer's CLI writes result.json (singular) into the working directory on
# every slice. The `results.json` entry below never matched it.
result.json
results.json
printer_capabilities.json
printer_snap.png
cf.log

# Ignore docs/md files inside node_modules or sub-dependencies
**/node_modules/**/*.md
**/node_modules/**/*.markdown

# Build / release artifacts (uv/pip venvs, wheels, sdists)
bin/
lib/
lib64
pyvenv.cfg
build/
dist/
wheelhouse/

# CLI-generated runtime artifacts and local secrets
access_code
printer_snapshot.jpg
*.3mf
*.gcode

# local artifacts
.coverage
.claude/
.ruff_cache/

# Local model files
downloads/
*.stl
*.3mf
*.gcode
*.step

# ...except the committed test fixtures, which are the only models in the repo
# and let `job`/`print` be exercised by hand without dropping a stray model in.
!tests/fixtures/*.stl
!tests/fixtures/*.3mf

# mutmut mutation testing artifacts
mutants/
.mutmut-cache

# hypothesis property-test cache (local machine paths; never ship)
.hypothesis/


# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Dependencies / Virtualenvs
node_modules/
.venv/
venv/
env/
bambu_venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log


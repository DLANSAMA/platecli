/* platecli TUI stylesheet. Colours come from the platecli theme (tui/theme.py);
   every layout is checked at 80x24 as well as on a wide terminal. */

Screen {
    layout: vertical;
    background: $background;
}

/* The one-line bar on every full screen (widgets/topbar.py). */

TopBar {
    height: 1;
    width: 100%;
    background: $surface;
    padding: 0 1;
}

#topbar-brand {
    width: auto;
    color: $primary;
    text-style: bold;
}

#topbar-title {
    width: 1fr;
    color: $foreground;
    padding: 0 0 0 2;
}

#topbar-printer {
    width: auto;
    color: $text-muted;
}

#topbar-badge {
    width: auto;
    margin: 0 0 0 2;
    padding: 0 1;
    text-style: bold;
    color: $text-muted;
    background: $panel;
}

#topbar-badge.-tone-active { color: $primary; background: $primary 15%; }
#topbar-badge.-tone-paused { color: $warning; background: $warning 15%; }
#topbar-badge.-tone-done { color: $success; background: $success 15%; }
#topbar-badge.-tone-error { color: $error; background: $error 15%; }
#topbar-badge.-tone-busy { color: $secondary; background: $secondary 15%; }


/* Dashboard: job hero, heater cards, AMS strip (scrolls only when the AMS
   has more units than the terminal has rows). */

#dashboard-body {
    height: 1fr;
    padding: 0 1;
}

JobHero {
    height: 7;
    margin: 1 0 0 0;
    padding: 0 2;
    border: round $primary 60%;
    border-title-color: $foreground;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}

JobHero.-tone-paused { border: round $warning 60%; }
JobHero.-tone-done { border: round $success 60%; }
JobHero.-tone-error { border: round $error 60%; }
JobHero.-tone-idle, JobHero.-tone-busy { border: round $panel-lighten-2; }

JobHero .hero-row {
    height: 3;
}

JobHero .hero-percent {
    width: auto;
    margin: 0 3 0 0;
    color: $primary;
    text-style: bold;
}

JobHero.-tone-paused .hero-percent { color: $warning; }
JobHero.-tone-done .hero-percent { color: $success; }
JobHero.-tone-error .hero-percent { color: $error; }

JobHero .hero-lines {
    width: 1fr;
    height: 3;
}

JobHero .hero-line {
    height: 1;
    color: $text-muted;
}

JobHero .hero-line-1 {
    color: $foreground;
    text-style: bold;
}

/* With no percentage the lines are the whole message: give them the room and
   push them off the top border so they read as one block. */
JobHero.-message .hero-row {
    height: 4;
    padding: 1 0 0 0;
}

JobHero.-message.-tone-error .hero-line-1 { color: $error; }

JobHero .hero-bar {
    height: 1;
    width: 100%;
    margin: 1 0 0 0;
}

WideBar > .widebar--done { color: $primary; }
WideBar > .widebar--todo { color: $panel-lighten-2; }
JobHero.-tone-paused WideBar > .widebar--done { color: $warning; }
JobHero.-tone-done WideBar > .widebar--done { color: $success; }
JobHero.-tone-error WideBar > .widebar--done { color: $error; }

/* The heater cards take whatever height is left (between 5 and 12 rows), so a
   tall terminal gets a taller history instead of empty space at the bottom. */
#temps, #monitor-temps {
    height: 1fr;
    min-height: 5;
    max-height: 12;
}

TempCard {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    border: round $panel-lighten-2;
    border-title-color: $secondary;
    border-title-style: bold;
}

TempCard:first-of-type {
    margin: 0 1 0 0;
}

TempCard .temp-reading {
    height: 1;
}

TempCard .temp-value {
    width: auto;
    color: $foreground;
    text-style: bold;
    margin: 0 2 0 0;
}

TempCard .temp-caption {
    width: 1fr;
    color: $text-muted;
}

TempCard.-heating .temp-caption {
    color: $accent;
}

TempCard .temp-spark {
    height: 1fr;
}

Spark > .spark--bar { color: $accent 85%; }
Spark > .spark--baseline { color: $panel-lighten-2; }
#temp-bed Spark > .spark--bar, #monitor-temp-bed Spark > .spark--bar { color: $secondary 85%; }

AmsStrip {
    height: auto;
}

.ams-note {
    height: 3;
    padding: 1 1;
    color: $text-muted;
}

.ams-unit {
    height: 7;
    padding: 0 1;
    border: round $panel-lighten-2;
    border-title-color: $secondary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}

.tray-card {
    width: 1fr;
    min-width: 10;
    height: 5;
    margin: 0 1 0 0;
    padding: 0 1;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
}

.tray-card.-active {
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
}

TrayCard > .tray--empty { color: $text-muted; background: $surface; }
TrayCard > .tray--meter { color: $primary; }
TrayCard > .tray--meter-low { color: $error; }
TrayCard > .tray--track { color: $panel-lighten-2; }
TrayCard > .tray--muted { color: $text-muted; }


/* Prepare flow (Phase 2). */

#prepare-body {
    height: 1fr;
    padding: 0 2;
}

/* Two columns: the form on the left, what the run produced on the right, so
   the estimate and "Start print…" are visible without scrolling past the form.
   PrepareScreen adds .narrow below TWO_COLUMN_MIN_WIDTH columns, where two
   halves are too thin for a material label and stacking reads better; there
   #prepare-body does the scrolling instead of the columns. */
#prepare-columns {
    width: 100%;
    height: 1fr;
}

/* 62, not 60: the longest radio label is the AMS-detected material
   ("PLA — easy, rigid, most models  (detected in AMS)") at 49 cells, and a
   RadioButton adds 4 for its toggle and padding = 53. A 60-wide column leaves
   the RadioSet 54 cells of content — one to spare — so the moment the form is
   taller than the terminal and this column grows a scrollbar, content drops to
   52 and the closing paren is clipped. Two extra columns absorb the scrollbar
   instead of silently truncating which material was detected. */
#prepare-inputs {
    width: 62;
    height: 100%;
    padding: 0 2 0 0;
}

/* A titled box, not a bare divider: before the first run this column holds only
   a disabled button, and unframed that read as a half-rendered widget. round,
   never thick — thick renders as solid slabs top and bottom (see 0d63378). */
#prepare-output {
    width: 1fr;
    min-width: 24;
    height: 100%;
    border: round $primary;
    border-title-color: $secondary;
    border-title-style: bold;
    padding: 0 1;
}

#prepare-inputs .settings-label {
    width: 14;
}

/* One form, not four boxes of unrelated size: the group controls all fill the
   column, so its right edge is a straight line instead of a stair-step. */
#prepare-inputs RadioSet,
#prepare-inputs Checkbox,
#prepare-inputs #prepare-actions {
    width: 100%;
}

#prepare-actions Button {
    width: 1fr;
}

.prepare-group {
    text-style: bold;
    color: $secondary;
    padding: 1 0 0 0;
    height: 2;
}

#prepare-columns.narrow {
    layout: vertical;
    height: auto;
}

#prepare-columns.narrow > #prepare-inputs,
#prepare-columns.narrow > #prepare-output {
    width: 100%;
    height: auto;
    padding: 0;
    border: none;
}

#source-error {
    color: $error;
    height: auto;
}

#prepare-status {
    color: $text-muted;
    height: auto;
    padding: 1 0 0 0;
}

#preview {
    height: auto;
    padding: 1 0;
}

#preflight-body {
    height: 1fr;
    padding: 1 2;
}

#preflight-title {
    text-style: bold;
    color: $error;
}

#preflight-problem {
    padding: 1 0;
    height: auto;
}

#preflight-hint {
    color: $text-muted;
    height: auto;
}


/* Confirm modal + job monitor (Phase 3). */

ConfirmModal {
    align: center middle;
}

#confirm-body {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: round $primary;
    border-title-color: $secondary;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

#confirm-title {
    text-style: bold;
}

#confirm-summary {
    height: auto;
    padding: 1 0 1 0;
}

#confirm-path {
    color: $text-muted;
    height: auto;
    padding: 0 0 1 0;
}

#confirm-buttons {
    height: auto;
    align: left middle;
}

#confirm-buttons Button {
    margin: 0 1 0 0;
}

#confirm-status {
    height: auto;
    padding: 1 0 0 0;
}

#monitor-body {
    height: 1fr;
    padding: 0 1;
}

#monitor-title {
    height: auto;
    padding: 1 1 0 1;
    color: $text-muted;
}

#monitor-hint {
    color: $text-muted;
    height: auto;
    padding: 1 1 0 1;
}


/* Help overlay (Phase 4). */

HelpScreen {
    align: center middle;
}

#help-body {
    width: 78;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: round $primary;
    border-title-color: $secondary;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

#help-keys {
    height: auto;
}


/* Advanced slice settings (Phase 5). */

#settings-body {
    height: 1fr;
    padding: 0 2;
}

#settings-intro {
    color: $text-muted;
    height: auto;
    padding: 0 0 1 0;
}

.settings-group {
    text-style: bold;
    color: $secondary;
    padding: 1 0 0 0;
    height: 2;
}

/* One row per field. The form is 25 fields plus an override editor; with
   stacked labels and default (bordered, 3-row) inputs only four fit on an
   80x24 terminal. Flat 1-row controls keep the whole group readable at once. */
.settings-row {
    height: 1;
    width: 100%;
}

.settings-label {
    width: 26;
    height: 1;
    color: $text-muted;
}

/* Flat by default: a filled background on every row merges 25 fields into one
   slab. Focus is what marks the active field. */
.settings-input {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
    padding: 0 1;
}

.settings-input:focus, .settings-input:focus-within {
    background: $primary 40%;
}

/* Select wraps its value in SelectCurrent, which brings its own border,
   background and padding — all of which break the one-row rhythm. */
.settings-input SelectCurrent {
    border: none;
    background: transparent;
    padding: 0 1;
    height: 1;
}

.settings-input:focus-within SelectCurrent {
    background: $primary 40%;
}

/* The override editor: a name, a bucket, and a value. */
#override-key, #override-bucket, #override-value {
    width: 100%;
}

#override-help, #override-note {
    height: auto;
    color: $text-muted;
}

#override-current {
    height: 4;
    border: round $secondary;
}


#settings-error {
    color: $error;
    height: auto;
    padding: 1 0 0 0;
}

#settings-buttons, #settings-actions, #prepare-actions {
    height: auto;
    align: left middle;
}

#settings-buttons Button, #settings-actions Button, #prepare-actions Button {
    margin: 0 1 0 0;
}

#settings-summary {
    height: auto;
    color: $text-muted;
}

/* platecli TUI stylesheet (Phase 1: read-only dashboard).
   Kept minimal and terminal-friendly; reviewed on a narrow 80x24 terminal. */

Screen {
    layout: vertical;
}

#dashboard-body {
    height: 1fr;
}

StatusPanel {
    width: 1fr;
    height: 100%;
    border: round $primary;
    padding: 1 2;
    content-align: left top;
}

AmsPanel {
    width: 1fr;
    height: 100%;
    border: round $secondary;
    padding: 1 2;
    content-align: left top;
}

#dashboard-hint {
    height: 1;
    color: $text-muted;
    padding: 0 2;
}


/* Prepare flow (Phase 2). */

#prepare-body {
    height: 1fr;
    padding: 0 2;
}

#source-error {
    color: $error;
    height: auto;
}

#prepare-status {
    color: $text-muted;
    height: auto;
    padding: 1 0 0 0;
}

#preview {
    height: auto;
    padding: 1 0;
}

#preflight-body {
    height: 1fr;
    padding: 1 2;
}

#preflight-title {
    text-style: bold;
    color: $error;
}

#preflight-problem {
    padding: 1 0;
    height: auto;
}

#preflight-hint {
    color: $text-muted;
    height: auto;
}
